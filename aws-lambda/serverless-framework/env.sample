# Your New Relic account id and license key
NEW_RELIC_ACCOUNT_ID=
NEW_RELIC_LICENSE_KEY=

# Agent log level, written to CloudWatch Logs
NEW_RELIC_LOG_LEVEL=info

# Uncomment if you are a New Relic employee and you want to use staging
# NEW_RELIC_ENVIRONMENT=staging

# Uncomment to invoke the function every minute
# ENABLE_SCHEDULE=true
